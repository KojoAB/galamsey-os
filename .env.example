# Galamsey Watch — environment variables. Copy to .env and fill in. NEVER commit .env.

# --- Supabase (free tier) ---------------------------------------------------
# Pipeline (server only, bypasses row-level security — keep secret):
#   Supabase → Project Settings → Database → Connection string → URI (session pooler)
SUPABASE_DB_URL=
# Web app (safe in the browser; row-level security protects the data). Put these in web/.env.local too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 to run the web map on built-in demo files with no database.
NEXT_PUBLIC_DEMO_MODE=

# --- Official agency sources (leave blank until access is granted) ---------
# Each takes a URL or local path to GeoJSON, zipped Shapefile or GeoPackage.
# Layers loaded from these are marked "verified".
GSS_BOUNDARIES_ADM1_URL=
GSS_BOUNDARIES_ADM2_URL=
FORESTRY_COMMISSION_RESERVES_URL=
WRC_RIVERS_URL=
MINERALS_COMMISSION_CADASTRE_URL=

# --- Open-data fallbacks ------------------------------------------------------
# Free token from https://api.protectedplanet.net/request (WDPA forest reserves)
PROTECTED_PLANET_API_TOKEN=
# Optional: local path to HydroRIVERS Africa shapefile (hydrosheds.org), used if OSM rivers fail
HYDRORIVERS_PATH=
# Optional: a different Overpass (OpenStreetMap) server
OVERPASS_URL=

# --- Pipeline: detection ---------------------------------------------------------
SUPABASE_URL=                     # same as NEXT_PUBLIC_SUPABASE_URL; used for Storage uploads
SUPABASE_SERVICE_ROLE_KEY=        # server only — web (tip webhook, invites) and pipeline (chips)
APP_URL=                          # public URL of the dashboard, used in alert links
GFW_API_KEY=                      # free, globalforestwatch.org → My GFW → API keys
GEE_SERVICE_ACCOUNT_KEY=          # Earth Engine service-account JSON (or path)
GEE_PROJECT=                      # Google Cloud project registered for Earth Engine
CDSE_CLIENT_ID=                   # Copernicus Data Space fallback (free)
CDSE_CLIENT_SECRET=
AI_CLASSIFIER=0                   # 1 = run the Amazon Mining Watch model (needs requirements-ai.txt)

# --- Notifications (SMS and WhatsApp cost money per message — approve before enabling)
NOTIFY_DRY_RUN=1                  # 1 = log only, 0 = really send
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TEMPLATE=galamsey_alert
SMS_PROVIDER=africastalking       # or hubtel
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
RESEND_API_KEY=
ALERT_EMAIL_FROM=                 # e.g. Galamsey Watch <alerts@yourdomain>

# --- Tip line (web) --------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=            # any long random string; paste the same into Meta's webhook settings
WHATSAPP_APP_SECRET=              # Meta app secret, used to verify webhook signatures
TIP_HASH_SALT=                    # 32+ random characters. Never change it (old tips would stop grouping)

# --- Government connectors (each: <ID>_URL, <ID>_TOKEN, or <ID>_MOCK=1 for test data)
MINERALS_COMMISSION_CADASTRE_MOCK=
MINERALS_COMMISSION_EQUIPMENT_MOCK=
FORESTRY_COMMISSION_MINING_MOCK=
CERSGIS_NRT_MOCK=
NAIMOS_MOCK=
WRC_WATER_QUALITY_MOCK=

# --- Paid Planet module (off) -------------------------------------------------------
PLANET_ENABLED=0
PLANET_API_KEY=
