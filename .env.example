# Galamsey Watch — environment variables. Copy to .env and fill in. NEVER commit .env.

# --- Supabase (free tier) ---------------------------------------------------
# Pipeline (server only, bypasses row-level security — keep secret):
#   Supabase → Project Settings → Database → Connection string → URI (session pooler)
SUPABASE_DB_URL=
# Web app (safe in the browser; row-level security protects the data). Put these in web/.env.local too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 to run the web map on built-in demo files with no database.
NEXT_PUBLIC_DEMO_MODE=

# --- Official agency sources (leave blank until access is granted) ---------
# Each takes a URL or local path to GeoJSON, zipped Shapefile or GeoPackage.
# Layers loaded from these are marked "verified".
GSS_BOUNDARIES_ADM1_URL=
GSS_BOUNDARIES_ADM2_URL=
FORESTRY_COMMISSION_RESERVES_URL=
WRC_RIVERS_URL=
MINERALS_COMMISSION_CADASTRE_URL=

# --- Open-data fallbacks ------------------------------------------------------
# Free token from https://api.protectedplanet.net/request (WDPA forest reserves)
PROTECTED_PLANET_API_TOKEN=
# Optional: local path to HydroRIVERS Africa shapefile (hydrosheds.org), used if OSM rivers fail
HYDRORIVERS_PATH=
# Optional: a different Overpass (OpenStreetMap) server
OVERPASS_URL=
